<?xml version="1.0" encoding="utf-8"?>
<!--
    Stable view-tag keys. Used with View.setTag(int, Object) so that state cached on a
    view (press-animation springs, attached-listener markers) survives RecyclerView
    recycling without colliding with any resource id.
-->
<resources>
    <item name="dynamic_anim_press_state" type="id" />
    <!-- Base (unscaled) icon dimensions, cached so the Icon Size preference never compounds. -->
    <item name="icon_size_base_width" type="id" />
    <item name="icon_size_base_height" type="id" />
    <!-- The single TouchDelegate installed on a container that holds small controls. -->
    <item name="touch_target_delegate" type="id" />
    <!-- Marks a view that already has the detach-time animation cancel listener installed. -->
    <item name="dynamic_anim_detach_guard" type="id" />
    <!-- Sequence number of the latest async text request on a view, so a stale measurement is
         dropped instead of overwriting newer text (item 127). -->
    <item name="async_text_sequence" type="id" />
</resources>