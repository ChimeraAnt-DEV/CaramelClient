<?xml version="1.0" encoding="utf-8"?>
<!--
    The Zoom overlay body: the icon with the current zoom level printed beneath it (item 192), so a
    player can see how far the zoom is dialled in without opening the config dialog. The root keeps
    the shared overlay button id so the base class's touch and layout handling is unchanged.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mod_overlay_button"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clickable="true"
    android:focusable="true"
    android:contentDescription="@string/inbuilt_mod_zoom">

    <ImageView
        android:id="@+id/zoom_icon"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        tools:src="@drawable/ic_zoom_normal" />

    <TextView
        android:id="@+id/zoom_level"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:background="@color/overlay_scrim"
        android:paddingStart="@dimen/space_1"
        android:paddingEnd="@dimen/space_1"
        android:textAppearance="@style/TextAppearance.Glowberry.Micro"
        android:textColor="@color/overlay_text_primary"
        tools:text="1.5x" />
</FrameLayout>
