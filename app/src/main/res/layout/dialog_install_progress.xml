<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:padding="@dimen/space_6"
    android:background="@drawable/dialog_background_black_border"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minWidth="300dp">

    <TextView
        android:id="@+id/tv_title"
        android:text="@string/installing_title"
        android:textAppearance="@style/TextAppearance.Caramel.Title"
        android:textStyle="bold"
        android:textColor="?attr/colorPrimary"
        android:fontFamily="@font/misans"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
    android:accessibilityHeading="true" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_6"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_progress_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_3"
            android:layout_weight="1"
            android:maxLines="2"
            android:text="@string/installing_message"
            android:textColor="?attr/colorOnSurface"
            android:textAppearance="@style/TextAppearance.Caramel.Title"
            android:textStyle="bold"
    android:accessibilityHeading="true" />

        <TextView
            android:id="@+id/tv_progress_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/misans"
            android:gravity="end"
            android:minWidth="54dp"
            tools:text="0%"
            android:textColor="?attr/colorPrimary"
            android:textAppearance="@style/TextAppearance.Caramel.Title"
            android:textStyle="bold"
    android:accessibilityHeading="true" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="7dp"
        android:layout_marginTop="@dimen/space_4"
        android:indeterminateOnly="false"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/bg_libs_repair_progress" />

    <!--
        Cancel. Hidden until a caller opts in with setCancelAction, so the install flow
        that must run to completion keeps its non-cancellable behaviour.
    -->
    <Button
        android:id="@+id/btn_cancel_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="@dimen/space_4"
        android:minHeight="@dimen/min_touch_target"
        android:background="?attr/selectableItemBackground"
        android:text="@string/cancel"
        android:textColor="?attr/colorPrimary"
        android:visibility="gone"
        tools:visibility="visible" />

</LinearLayout>
