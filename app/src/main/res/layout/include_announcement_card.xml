<?xml version="1.0" encoding="utf-8"?>
<!--
    The Launch-tab announcement card (item 255). Hidden until the announcement feed yields a card
    that applies to this build and has not been dismissed. It is a plain glass card so it matches the
    rest of the Launch tab, with a title, a body, an optional link action and a dismiss button.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/announcement_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_3"
    android:visibility="gone"
    app:cardBackgroundColor="@color/glass_panel_bg"
    app:cardCornerRadius="@dimen/radius_card"
    app:strokeColor="@color/glass_panel_stroke"
    app:strokeWidth="1dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/space_4">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="@dimen/space_3"
            android:contentDescription="@null"
            android:src="@drawable/ic_notifications"
            app:tint="@color/accent_violet" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/announcement_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/misans"
                android:textColor="@color/dock_text_primary"
                android:textAppearance="@style/TextAppearance.Glowberry.Label"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/announcement_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_hairline"
                android:fontFamily="@font/misans"
                android:textColor="@color/dock_text_secondary"
                android:textAppearance="@style/TextAppearance.Glowberry.Caption" />

            <TextView
                android:id="@+id/announcement_link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/misans"
                android:minHeight="@dimen/min_touch_target"
                android:gravity="center_vertical"
                android:text="@string/announcement_learn_more"
                android:textColor="@color/primary"
                android:textAppearance="@style/TextAppearance.Glowberry.Caption"
                android:visibility="gone" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/announcement_dismiss"
            android:layout_width="@dimen/min_touch_target"
            android:layout_height="@dimen/min_touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/announcement_dismiss"
            android:src="@drawable/ic_close"
            app:tint="@color/dock_text_secondary" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
