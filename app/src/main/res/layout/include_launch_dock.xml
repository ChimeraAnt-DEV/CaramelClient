<?xml version="1.0" encoding="utf-8"?>
<!--
    The docked launch control bar: the active profile/version on the left and the Play button on the
    right, on one dark translucent Material 3 plate docked at the bottom of the Launch tab. This is
    what stops the launch controls from floating loose across the page.

    The ids @id/launch_button and @id/select_version_button are kept because the activity binds the
    launch click, the version-select popup anchor, the card rounding and the glow pass to them.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardCornerRadius="@dimen/radius_window"
    app:strokeWidth="0dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_launch_dock"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_4"
        android:paddingVertical="@dimen/space_4">

        <!--
            Profile on the left, version as a chip on the right (U15). The chip is the version
            selector: it is a compact tap target that reads as data, not as a second button, and it
            keeps the dock one row tall so the Play action gets the full width below it. The ids
            @id/select_version_button and @id/text_minecraft_version are unchanged because the
            activity binds the popup anchor and the version text to them.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/dock_profile_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/misans"
                android:text="@string/dock_profile_default"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/dock_text_primary"
                android:textAppearance="@style/TextAppearance.Caramel.Title"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/select_version_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:background="@drawable/bg_dock_version_chip"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/space_3">

                <TextView
                    android:id="@+id/text_minecraft_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/misans"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:maxWidth="180dp"
                    android:text="@string/home_edition_version_placeholder"
                    android:textColor="@color/mc_stone_text"
                    android:textAppearance="@style/TextAppearance.Caramel.Caption" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="@dimen/space_2"
                    android:src="@drawable/ic_arrow_down"
                    app:tint="@color/dock_text_secondary" 
                    android:importantForAccessibility="no"
                    />
            </LinearLayout>
        </LinearLayout>

        <!-- The pack's split LAUNCH GAME control: one green gradient face carrying the action and
             the build it will start, with a chevron segment that opens the launch options. The two
             halves are separate tap targets on one surface, so "start a session" and "change what
             starts" cannot be confused. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/split_launch_height"
            android:layout_marginTop="@dimen/space_3"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/launch_button"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_split_launch"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/launch_button_label"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/space_6"
                    android:paddingEnd="@dimen/space_4">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat"
                        android:letterSpacing="0.08"
                        android:text="@string/launch_button_label"
                        android:textColor="@color/split_launch_text"
                        android:textAppearance="@style/TextAppearance.Caramel.Title"
                        android:textStyle="bold"
                        android:textAllCaps="true" />

                    <TextView
                        android:id="@+id/launch_button_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="@string/home_edition_version_placeholder"
                        android:textColor="@color/split_launch_subtext"
                        android:textAppearance="@style/TextAppearance.Caramel.Caption" />
                </LinearLayout>

                <!-- Sweeping highlight while the launcher prepares; GONE once ready. -->
                <View
                    android:id="@+id/launch_button_shimmer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_dock_shimmer"
                    android:visibility="gone" />
            </FrameLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="@dimen/split_launch_divider_height"
                android:layout_gravity="center_vertical"
                android:background="@color/split_launch_divider" />

            <ImageButton
                android:id="@+id/launch_chevron"
                android:layout_width="@dimen/split_launch_chevron_width"
                android:layout_height="match_parent"
                android:background="@drawable/bg_split_launch_chevron"
                android:contentDescription="@string/launch_menu_open"
                android:src="@drawable/ic_arrow_down"
                android:scaleType="center"
                app:tint="@color/split_launch_text" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress_loader"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="@dimen/space_3"
            android:indeterminate="true"
            android:visibility="gone"
            android:indeterminateTint="@color/primary" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
