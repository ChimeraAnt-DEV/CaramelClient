<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_6"
            android:paddingEnd="@dimen/space_6"
            android:paddingTop="@dimen/space_4"
            android:paddingBottom="@dimen/space_6">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/about_page_title"
                android:fontFamily="@font/misans"
                android:textColor="@color/primary"
                android:textAppearance="@style/TextAppearance.Caramel.Display"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:text="@string/about_subtitle"
                android:fontFamily="@font/misans"
                android:textColor="@color/text_secondary"
                android:textAppearance="@style/TextAppearance.Caramel.Body" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_6"
                style="@style/Widget.Caramel.Card.Compact"
                android:orientation="vertical"
                android:padding="@dimen/space_4">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/about_people_title"
                    android:fontFamily="@font/misans"
                    android:textColor="@color/on_surface"
                    android:textAppearance="@style/TextAppearance.Caramel.Title"
                    android:textStyle="bold"
                    android:accessibilityHeading="true" />

                <!-- The owner. Tapping the avatar or the name opens the GitHub profile; the chips
                     below are the explicit routes. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.microsoft.xbox.idp.toolkit.CircleImageView
                        android:id="@+id/owner_avatar"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_qa_account"
                        android:scaleType="centerCrop"
                        android:importantForAccessibility="no" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/space_3"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/owner_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/about_owner_name"
                                android:fontFamily="@font/misans"
                                android:textColor="@color/on_surface"
                                android:textAppearance="@style/TextAppearance.Caramel.Title"
                                android:textStyle="bold"
                                android:accessibilityHeading="true"
                                android:clickable="true"
                                android:focusable="true" />

                            <TextView
                                android:id="@+id/owner_badge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minHeight="18dp"
                                android:layout_marginStart="@dimen/space_2"
                                android:paddingHorizontal="@dimen/space_2"
                                android:gravity="center"
                                android:text="@string/about_owner_badge"
                                android:fontFamily="@font/misans"
                                android:textColor="@color/on_primary"
                                android:textAppearance="@style/TextAppearance.Caramel.Micro"
                                android:textStyle="bold"
                                android:background="@drawable/bg_author_badge" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/owner_role"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_hairline"
                            android:text="@string/about_owner_role"
                            android:fontFamily="@font/misans"
                            android:textColor="@color/text_secondary"
                            android:textAppearance="@style/TextAppearance.Caramel.Caption" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_2"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/btn_owner_github"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minHeight="28dp"
                                android:paddingHorizontal="@dimen/space_4"
                                android:gravity="center"
                                android:text="@string/about_github"
                                android:fontFamily="@font/misans"
                                android:textColor="@color/on_surface"
                                android:textAppearance="@style/TextAppearance.Caramel.Caption"
                                android:background="@drawable/bg_link_chip_blue"
                                android:drawableStart="@drawable/ic_github"
                                android:drawablePadding="@dimen/space_2"
                                android:clickable="true"
                                android:focusable="true" />

                            <TextView
                                android:id="@+id/btn_owner_youtube"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minHeight="28dp"
                                android:layout_marginStart="@dimen/space_2"
                                android:paddingHorizontal="@dimen/space_4"
                                android:gravity="center"
                                android:text="@string/youtube"
                                android:fontFamily="@font/misans"
                                android:textColor="@color/error"
                                android:textAppearance="@style/TextAppearance.Caramel.Caption"
                                android:textStyle="bold"
                                android:background="@drawable/bg_link_chip_pink"
                                android:drawableStart="@drawable/ic_youtube"
                                android:drawablePadding="@dimen/space_2"
                                android:clickable="true"
                                android:focusable="true" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/space_4"
                    android:layout_marginBottom="@dimen/space_hairline"
                    android:background="@color/wash_black_10" />

                <!-- The lead developer. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.microsoft.xbox.idp.toolkit.CircleImageView
                        android:id="@+id/lead_avatar"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_qa_account"
                        android:scaleType="centerCrop"
                        android:importantForAccessibility="no" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/space_3"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/lead_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/about_lead_name"
                                android:fontFamily="@font/misans"
                                android:textColor="@color/on_surface"
                                android:textAppearance="@style/TextAppearance.Caramel.Title"
                                android:textStyle="bold"
                                android:accessibilityHeading="true"
                                android:clickable="true"
                                android:focusable="true" />

                            <TextView
                                android:id="@+id/lead_badge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minHeight="18dp"
                                android:layout_marginStart="@dimen/space_2"
                                android:paddingHorizontal="@dimen/space_2"
                                android:gravity="center"
                                android:text="@string/about_lead_badge"
                                android:fontFamily="@font/misans"
                                android:textColor="@color/on_primary"
                                android:textAppearance="@style/TextAppearance.Caramel.Micro"
                                android:textStyle="bold"
                                android:background="@drawable/bg_author_badge" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/lead_role"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_hairline"
                            android:text="@string/about_lead_role"
                            android:fontFamily="@font/misans"
                            android:textColor="@color/text_secondary"
                            android:textAppearance="@style/TextAppearance.Caramel.Caption" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_2"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/btn_lead_github"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minHeight="28dp"
                                android:paddingHorizontal="@dimen/space_4"
                                android:gravity="center"
                                android:text="@string/about_github"
                                android:fontFamily="@font/misans"
                                android:textColor="@color/on_surface"
                                android:textAppearance="@style/TextAppearance.Caramel.Caption"
                                android:background="@drawable/bg_link_chip_blue"
                                android:drawableStart="@drawable/ic_github"
                                android:drawablePadding="@dimen/space_2"
                                android:clickable="true"
                                android:focusable="true" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/space_2"
                    style="@style/Widget.Caramel.Card.Compact"
                    android:orientation="vertical"
                    android:padding="@dimen/space_4">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/about_source_title"
                        android:fontFamily="@font/misans"
                        android:textColor="@color/on_surface"
                        android:textAppearance="@style/TextAppearance.Caramel.Title"
                        android:textStyle="bold"
                        android:drawableStart="@drawable/ic_code"
                        android:drawablePadding="@dimen/space_2"
    android:accessibilityHeading="true" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_3"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btn_github_repo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="28dp"
                            android:paddingHorizontal="@dimen/space_4"
                            android:gravity="center"
                            android:text="@string/about_github_repo"
                            android:fontFamily="@font/misans"
                            android:textColor="@color/on_surface"
                            android:textAppearance="@style/TextAppearance.Caramel.Caption"
                            android:background="@drawable/bg_link_chip_blue"
                            android:drawableStart="@drawable/ic_github"
                            android:drawablePadding="@dimen/space_2"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/btn_github_org"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="28dp"
                            android:layout_marginStart="@dimen/space_2"
                            android:paddingHorizontal="@dimen/space_4"
                            android:gravity="center"
                            android:text="@string/about_github_org"
                            android:fontFamily="@font/misans"
                            android:textColor="@color/on_surface"
                            android:textAppearance="@style/TextAppearance.Caramel.Caption"
                            android:background="@drawable/bg_link_chip_blue"
                            android:drawableStart="@drawable/ic_github"
                            android:drawablePadding="@dimen/space_2"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/about_build_info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_3"
                        android:fontFamily="@font/misans"
                        android:textColor="@color/text_secondary"
                        android:textAppearance="@style/TextAppearance.Caramel.Caption" />

                    <TextView
                        android:id="@+id/about_native_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:fontFamily="@font/misans"
                        android:textColor="@color/text_secondary"
                        android:textAppearance="@style/TextAppearance.Caramel.Caption" />

                    <TextView
                        android:id="@+id/about_backend_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_3"
                        android:fontFamily="@font/misans"
                        android:textColor="@color/text_secondary"
                        android:textAppearance="@style/TextAppearance.Caramel.Caption" />

                    <TextView
                        android:id="@+id/about_input_backend_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:fontFamily="@font/misans"
                        android:textColor="@color/text_secondary"
                        android:textAppearance="@style/TextAppearance.Caramel.Caption" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_3"
                        android:text="@string/about_license_note"
                        android:fontFamily="@font/misans"
                        android:textColor="@color/text_secondary"
                        android:textAppearance="@style/TextAppearance.Caramel.Caption" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_2"
                    style="@style/Widget.Caramel.Card.Compact"
                    android:orientation="vertical"
                    android:padding="@dimen/space_4">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/about_contribute_title"
                        android:fontFamily="@font/misans"
                        android:textColor="@color/on_surface"
                        android:textAppearance="@style/TextAppearance.Caramel.Title"
                        android:textStyle="bold"
                        android:drawableStart="@drawable/ic_github"
                        android:drawablePadding="@dimen/space_2"
    android:accessibilityHeading="true" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:text="@string/about_contribute_desc"
                        android:fontFamily="@font/misans"
                        android:textColor="@color/text_secondary"
                        android:textAppearance="@style/TextAppearance.Caramel.Caption" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_3"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btn_issues"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="28dp"
                            android:paddingHorizontal="@dimen/space_4"
                            android:gravity="center"
                            android:text="@string/about_issues"
                            android:fontFamily="@font/misans"
                            android:textColor="@color/on_surface"
                            android:textAppearance="@style/TextAppearance.Caramel.Caption"
                            android:background="@drawable/bg_link_chip_blue"
                            android:drawableStart="@drawable/ic_github"
                            android:drawablePadding="@dimen/space_2"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/btn_star_fork"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="28dp"
                            android:layout_marginStart="@dimen/space_2"
                            android:paddingHorizontal="@dimen/space_4"
                            android:gravity="center"
                            android:text="@string/about_star_fork"
                            android:fontFamily="@font/misans"
                            android:textColor="@color/primary"
                            android:textAppearance="@style/TextAppearance.Caramel.Caption"
                            android:textStyle="bold"
                            android:background="@drawable/bg_link_chip_green"
                            android:drawableStart="@drawable/ic_star"
                            android:drawablePadding="@dimen/space_2"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
