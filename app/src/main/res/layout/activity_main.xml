<?xml version="1.0" encoding="utf-8"?>
<!--
    The Launch tab: one Caramel Compose screen.

    The whole page is the pack's launcher UI, ported from CaramelClient-UI-pack — the brand row, the
    sidebar and the hero with its split launch control. It is a single ComposeView because the pack
    is one Compose screen: splitting it back into an XML column with Compose islands is what let the
    old launch tab keep its pre-pack look while the Compose pieces inside it changed.

    The root stays a plain FrameLayout so the personalization passes that tint or dim the whole
    screen (background image, dim scrim, entrance fade) still have one view to act on.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/launch_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/launch_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>
