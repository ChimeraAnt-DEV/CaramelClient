<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:id="@+id/script_manager_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_6"
        android:paddingTop="@dimen/space_4"
        android:paddingBottom="@dimen/space_6">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/script_manager_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_3"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/misans"
                android:maxLines="1"
                android:text="@string/script_manager_title"
                android:textColor="@color/primary"
                android:textAppearance="@style/TextAppearance.Glowberry.Display"
                android:textStyle="bold" />

            <Button
                android:id="@+id/script_manager_reload_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/primary"
                android:fontFamily="@font/misans"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="@dimen/min_touch_target"
                android:minWidth="0dp"
                android:paddingHorizontal="@dimen/space_4"
                android:text="@string/script_manager_reload"
                android:textAllCaps="false"
                android:textAppearance="@style/TextAppearance.Glowberry.Label"
                android:textColor="@color/on_primary"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/script_manager_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:fontFamily="@font/misans"
            android:text="@string/script_manager_subtitle"
            android:textColor="@color/text_secondary"
            android:textAppearance="@style/TextAppearance.Glowberry.Caption" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/space_4"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/script_manager_recycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:descendantFocusability="afterDescendants" />

            <ProgressBar
                android:id="@+id/script_manager_loading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

            <TextView
                android:id="@+id/script_manager_empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/misans"
                android:gravity="center"
                android:text="@string/script_manager_empty"
                android:textColor="@color/on_surface"
                android:textAppearance="@style/TextAppearance.Glowberry.Body"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
