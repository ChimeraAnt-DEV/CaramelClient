<?xml version="1.0" encoding="utf-8"?>
<!--
    The launch screen. The default state is calm and centred: the Glowberry logo, the status line and
    a rotating colour-shifting ring that reports the launch phase on its own. The raw launch log is a
    diagnostic, so it lives behind the "Show launch log" setting and is hidden unless the user opts
    in; when it is off the whole screen is just the logo, the status and the ring.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".launcher.core.minecraft.MinecraftLoadingActivity">

    <!-- The centred launch lockup: logo, ring, status. Always visible. -->
    <LinearLayout
        android:id="@+id/minecraftLaunchCenter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_8">

        <ImageView
            android:id="@+id/minecraftLaunchLogo"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:contentDescription="@string/splash_logo_desc"
            android:src="@drawable/ic_glowberry_logo" />


        <TextView
            android:id="@+id/minecraftLaunchStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_6"
            android:includeFontPadding="false"
            android:gravity="center"
            android:text="@string/minecraft_loading_status_preparing"
            android:textColor="@color/on_background"
            android:textAppearance="@style/TextAppearance.Glowberry.Title" />

        <TextView
            android:id="@+id/minecraftLaunchDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:includeFontPadding="false"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:textAppearance="@style/TextAppearance.Glowberry.Label" />

        <!--
            The changelog line: the newest release's headline and the upcoming one, on the launch
            screen. The launch screen is the one place every player passes through on every launch,
            so it is where "what changed" and "what is next" actually get read; the full screen is
            still reachable from Settings. Hidden when no feed is bundled.
        -->
        <TextView
            android:id="@+id/minecraftLaunchChangelog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:includeFontPadding="false"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="@color/text_secondary"
            android:textAppearance="@style/TextAppearance.Glowberry.Caption"
            android:visibility="gone" />
    </LinearLayout>

    <!-- The raw log, shown only when the user turns on "Show launch log" in Settings. -->
    <LinearLayout
        android:id="@+id/minecraftLaunchLogContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_4"
        android:paddingTop="@dimen/space_4"
        android:paddingBottom="@dimen/space_4"
        android:visibility="gone"
        tools:visibility="gone">

        <TextView
            android:id="@+id/minecraftLaunchLogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:accessibilityHeading="true"
            android:text="@string/minecraft_loading_log_title"
            android:textColor="@color/on_background"
            android:textAppearance="@style/TextAppearance.Glowberry.Body"
            android:textStyle="bold" />

        <ScrollView
            android:id="@+id/minecraftLaunchLogScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/space_3"
            android:layout_weight="1"
            android:background="@drawable/bg_minecraft_loading_terminal"
            android:fadeScrollbars="false"
            android:padding="@dimen/space_4"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/minecraftLaunchLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/on_header_gradient_secondary"
                android:textAppearance="@style/TextAppearance.Glowberry.Caption" />
        </ScrollView>
    </LinearLayout>

    <!-- The launch ring, pinned to the bottom-right so it reads as a spinner beside the screen
         rather than part of the centred message. The status keeps the centre to itself. -->
    <org.chimeramc.client.launcher.ui.views.LaunchRingView
        android:id="@+id/minecraftLaunchRing"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/space_6"
        android:layout_marginBottom="@dimen/space_8"
        android:importantForAccessibility="no" />

    <Button
        android:id="@+id/minecraftLaunchReturn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="@dimen/space_6"
        android:minHeight="44dp"
        android:visibility="gone"
        tools:visibility="visible" />

</FrameLayout>
