<?xml version="1.0" encoding="utf-8"?>
<!--
    The FPS overlay body: the readout line plus, when the frame-time graph is enabled, a small
    polyline of the last two seconds of frame intervals (item 191). The graph is the child of a
    vertical container so the readout keeps the exact look it had; the graph is GONE until the user
    turns it on, so the default overlay is unchanged.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@color/overlay_scrim"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_2"
    android:paddingEnd="@dimen/space_2"
    android:paddingTop="@dimen/space_1"
    android:paddingBottom="@dimen/space_1">

    <TextView
        android:id="@+id/stats_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/overlay_text_primary"
        android:textAppearance="@style/TextAppearance.Glowberry.Caption"
        android:fontFamily="monospace"
        tools:text="0" />

    <org.chimeramc.client.launcher.core.mods.inbuilt.overlay.FrameTimeGraphView
        android:id="@+id/frame_time_graph"
        android:layout_width="120dp"
        android:layout_height="32dp"
        android:layout_marginTop="@dimen/space_1"
        android:visibility="gone"
        tools:visibility="visible" />
</LinearLayout>
