<?xml version="1.0" encoding="utf-8"?>
<!--
  Splash screen: a random Minecraft key-art background, the logo + wordmark lockup centred, and a
  smooth rotating circle in the bottom-right.

  The 3D scene (floating island, ore block, pickaxe swing, block-break, wordmark shatter) is gone.
  It drew a particle system, a terrain mesh and several animated sprites every frame on the
  cold-start path, for a screen that is visible for a couple of seconds. A still image plus one
  rotating arc is one decode and one draw call.

  The disclaimer at the bottom is the attribution the Minecraft Usage Guidelines require on
  materials that use Mojang's assets.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/splash_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".launcher.ui.activities.SplashActivity">

    <!-- The randomised background. centerCrop so a 1110x624 wallpaper fills a tall phone screen
         without letterboxing or distortion. -->
    <ImageView
        android:id="@+id/splash_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/splash_background_desc"
        android:scaleType="centerCrop"
        android:src="@drawable/splash_bg_1" />

    <!-- A scrim so the wordmark stays legible over any background. -->
    <View
        android:id="@+id/splash_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/splash_scrim" />

    <LinearLayout
        android:id="@+id/splash_lockup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center">

            <View
                android:id="@+id/logoGlow"
                android:layout_width="132dp"
                android:layout_height="132dp"
                android:background="@drawable/bg_logo_glow" />

            <ImageView
                android:id="@+id/imgLeaf"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:layout_gravity="center"
                android:contentDescription="@string/splash_logo_desc"
                android:src="@drawable/ic_glowberry_logo" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/splash_wordmark_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_4"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAppName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:letterSpacing="0.04"
                android:text="@string/app_name"
                android:textColor="@color/on_background"
                android:textAppearance="@style/TextAppearance.Glowberry.Wordmark"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPreparing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:alpha="0.7"
                android:letterSpacing="0.08"
                android:text="@string/preparing_to_launch"
                android:textColor="@color/on_background"
                android:textAppearance="@style/TextAppearance.Glowberry.Caption" />
        </LinearLayout>
    </LinearLayout>

    <!-- The loader: a smooth circle rotating in the bottom-right. -->
    <org.chimeramc.client.launcher.ui.splash.SplashSpinner
        android:id="@+id/splash_spinner"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/space_8"
        android:layout_marginBottom="@dimen/space_8" />

    <!-- The attribution the Minecraft Usage Guidelines require. -->
    <TextView
        android:id="@+id/splash_disclaimer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:alpha="0.55"
        android:gravity="center"
        android:letterSpacing="0.04"
        android:paddingStart="@dimen/space_8"
        android:paddingEnd="@dimen/space_8"
        android:paddingBottom="@dimen/space_4"
        android:text="@string/minecraft_disclaimer"
        android:textColor="@color/on_background"
        android:textAppearance="@style/TextAppearance.Glowberry.Caption" />

</FrameLayout>
