<?xml version="1.0" encoding="utf-8"?>
<!--
    The server row's favourite star: filled when the row is starred, an outline when it
    is not. A state-list drawable rather than two swaps in code, so the star's appearance and the
    button's selected state cannot disagree.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true" android:drawable="@drawable/ic_star_filled" />
    <item android:drawable="@drawable/ic_star_outline" />
</selector>
