<?xml version="1.0" encoding="utf-8"?>
<!--
    The Play button: the light-blue Minecraft-style action. Bedrock's own Play button is a flat
    light blue with a darker bottom edge that reads as a raised face, so this is a three-stop
    vertical gradient (lighter top, light middle, darker bottom) inside a squared-off radius. The
    square-ish corners are deliberate: the Minecraft button look is a slab, not a pill.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The darker edge, a couple of dp proud at the bottom, so the face reads as raised. -->
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/mc_button_edge"
                android:endColor="@color/mc_button_edge"
                android:angle="270" />
            <corners android:radius="@dimen/radius_button_mc" />
        </shape>
    </item>
    <!-- The face. -->
    <item android:top="0dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/mc_button_top"
                android:centerColor="@color/mc_button_face"
                android:endColor="@color/mc_button_bottom"
                android:angle="270" />
            <corners android:radius="@dimen/radius_button_mc" />
            <stroke android:width="1dp" android:color="@color/mc_button_stroke" />
        </shape>
    </item>
</layer-list>
