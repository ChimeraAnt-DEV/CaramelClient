<?xml version="1.0" encoding="utf-8"?>
<!--
    The Play button: the light-blue Minecraft-style action. Bedrock's own Play button is a flat
    light blue with a darker bottom edge that reads as a raised face, so this is a three-stop
    vertical gradient (lighter top, light middle, darker bottom) inside a squared-off radius. The
    square-ish corners are deliberate: the Minecraft button look is a slab, not a pill.

    It presses. A slab with no pressed state is the "animated UI buttons look trash" report: the
    button never moved, so it felt dead. On press the whole face drops by the edge depth (3dp) and
    the edge is not drawn, so the slab visibly sinks onto its base; a ripple runs over it. The 3dp
    matches UiButton.EDGE_DEPTH_DP, so a code-drawn slab and this one depress identically.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/colorControlHighlight">
    <item>
        <selector>
            <!-- Focused: a bright ring around the slab, so a controller user sees the selection. -->
            <item android:state_focused="true">
                <layer-list>
                    <item>
                        <shape android:shape="rectangle">
                            <corners android:radius="@dimen/radius_button_mc" />
                            <stroke android:width="2dp" android:color="@color/ui_focus_ring" />
                        </shape>
                    </item>
                    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="5dp">
                        <shape android:shape="rectangle">
                            <gradient
                                android:startColor="@color/mc_button_top"
                                android:centerColor="@color/mc_button_face"
                                android:endColor="@color/mc_button_bottom"
                                android:angle="270" />
                            <corners android:radius="@dimen/radius_button_mc" />
                        </shape>
                    </item>
                    <item android:left="2dp" android:right="2dp" android:bottom="2dp">
                        <shape android:shape="rectangle">
                            <gradient
                                android:startColor="@color/mc_button_edge"
                                android:endColor="@color/mc_button_edge"
                                android:angle="270" />
                            <corners android:radius="@dimen/radius_button_mc" />
                        </shape>
                    </item>
                </layer-list>
            </item>
            <!-- Pressed: the face only, shifted down by the edge depth, so the edge vanishes. -->
            <item android:state_pressed="true">
                <layer-list>
                    <item android:top="3dp">
                        <shape android:shape="rectangle">
                            <gradient
                                android:startColor="@color/mc_button_top"
                                android:centerColor="@color/mc_button_face"
                                android:endColor="@color/mc_button_bottom"
                                android:angle="270" />
                            <corners android:radius="@dimen/radius_button_mc" />
                            <stroke android:width="1dp" android:color="@color/mc_button_stroke" />
                        </shape>
                    </item>
                </layer-list>
            </item>
            <!-- Resting: the darker edge a couple of dp proud at the bottom, then the face. -->
            <item>
                <layer-list>
                    <item android:bottom="3dp">
                        <shape android:shape="rectangle">
                            <gradient
                                android:startColor="@color/mc_button_edge"
                                android:endColor="@color/mc_button_edge"
                                android:angle="270" />
                            <corners android:radius="@dimen/radius_button_mc" />
                        </shape>
                    </item>
                    <item android:top="0dp" android:bottom="3dp">
                        <shape android:shape="rectangle">
                            <gradient
                                android:startColor="@color/mc_button_top"
                                android:centerColor="@color/mc_button_face"
                                android:endColor="@color/mc_button_bottom"
                                android:angle="270" />
                            <corners android:radius="@dimen/radius_button_mc" />
                            <stroke android:width="1dp" android:color="@color/mc_button_stroke" />
                        </shape>
                    </item>
                </layer-list>
            </item>
        </selector>
    </item>
</ripple>
