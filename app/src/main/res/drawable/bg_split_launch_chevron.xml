<?xml version="1.0" encoding="utf-8"?>
<!--
    The split LAUNCH GAME button's chevron segment: the same green face as
    @drawable/bg_split_launch, but rounded only on its trailing edge.

    It sits flush against the main segment so the two read as one control, which is why it has no
    left rounding. A visible seam between them would make it read as two buttons, which is the shape
    the split button exists to avoid.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="@color/split_launch_pressed"
                        android:endColor="@color/split_launch_pressed"
                        android:angle="270" />
                    <corners android:topRightRadius="@dimen/radius_split_launch"
                        android:bottomRightRadius="@dimen/radius_split_launch" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="@color/split_launch_top"
                        android:endColor="@color/split_launch_bottom"
                        android:angle="270" />
                    <corners android:topRightRadius="@dimen/radius_split_launch"
                        android:bottomRightRadius="@dimen/radius_split_launch" />
                </shape>
            </item>
            <item android:bottom="18dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="@color/split_launch_sheen"
                        android:endColor="@android:color/transparent"
                        android:angle="270" />
                    <corners android:topRightRadius="@dimen/radius_split_launch" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:topRightRadius="@dimen/radius_split_launch"
                        android:bottomRightRadius="@dimen/radius_split_launch" />
                    <stroke android:width="1dp" android:color="@color/split_launch_border" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
