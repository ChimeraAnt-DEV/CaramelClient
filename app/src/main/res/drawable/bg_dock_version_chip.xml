<?xml version="1.0" encoding="utf-8"?>
<!--
    The instance-select dropdown: its own slab, matching the Play button's squared-off Minecraft
    look but in the neutral stone tone, so the two read as siblings that are not joined.

    It presses: a ripple over a pressed face a step darker than the resting stone, so the chip
    responds like the Play slab beside it rather than sitting inert.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/colorControlHighlight">
    <item>
        <selector>
            <item android:state_focused="true">
                <layer-list>
                    <item>
                        <shape android:shape="rectangle">
                            <corners android:radius="@dimen/radius_button_mc" />
                            <stroke android:width="2dp" android:color="@color/ui_focus_ring" />
                        </shape>
                    </item>
                    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
                        <shape android:shape="rectangle">
                            <corners android:radius="@dimen/radius_button_mc" />
                            <solid android:color="@color/mc_stone_face" />
                        </shape>
                    </item>
                </layer-list>
            </item>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/mc_stone_pressed" />
                    <corners android:radius="@dimen/radius_button_mc" />
                    <stroke android:width="1dp" android:color="@color/mc_stone_stroke" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/mc_stone_face" />
                    <corners android:radius="@dimen/radius_button_mc" />
                    <stroke android:width="1dp" android:color="@color/mc_stone_stroke" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
