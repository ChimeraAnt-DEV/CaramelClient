<?xml version="1.0" encoding="utf-8"?>
<!--
    The shared glass card. A single flat fill with a hairline reads as a grey rectangle; what makes a
    surface read as glass is the light: a brighter top edge, a vertical sheen that falls off downward,
    and a rim that is brighter at the top than the bottom. Three stacked layers give that without a
    blur pass, so it costs nothing per frame and works on every supported version.

    Layer order (first drawn is at the back):
      1. the rim, a 1dp stroke whose colour is the top highlight
      2. the sheen, a vertical gradient from a light tint to transparent
      3. the fill, the base panel colour
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1. The rim: the outer edge, brightest at the top, so the card catches light from above. -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_chip" />
            <gradient
                android:startColor="@color/glass_rim_top"
                android:endColor="@color/glass_rim_bottom"
                android:angle="270" />
        </shape>
    </item>
    <!-- 2. The sheen, inset by the rim's width so it sits inside it. -->
    <item android:top="1dp" android:bottom="1dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_chip" />
            <gradient
                android:startColor="@color/glass_sheen"
                android:endColor="@color/glass_sheen_end"
                android:angle="270" />
        </shape>
    </item>
    <!-- 3. The fill, inset by the rim so the stroke shows. -->
    <item android:top="1dp" android:bottom="1dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_chip" />
            <solid android:color="@color/glass_background" />
        </shape>
    </item>
</layer-list>
